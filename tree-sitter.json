{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gsformula",
      "camelcase": "GsFormula",
      "scope": "source.gsformula",
      "file-types": ["gsfx"],
      "injection-regex": "^gsformula$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Google Sheets formulas",
    "authors": [
      {
        "name": "Colin Perel"
      }
    ],
    "links": {
      "repository": "https://github.com/colinperel/tree-sitter-gsformula"
    }
  }
}
