{
  "$schema": "https://raw.githubusercontent.com/ribru17/ts_query_ls/refs/heads/master/schemas/config.json",
  "parser_install_directories": ["."],
  "valid_captures": {
    "highlights": {
      "boolean.builtin": "TRUE/FALSE literals",
      "constant.builtin": "error literals and table selectors",
      "function.builtin": "known Sheets function heads",
      "function.call": "other call heads",
      "number": "numeric literals",
      "operator": "binary/unary/postfix operators",
      "property": "chip-extraction fields",
      "punctuation.bracket": "parens, braces, brackets",
      "punctuation.delimiter": "argument and array separators",
      "string": "string literals",
      "type": "sheet qualifiers",
      "variable": "identifier fallback",
      "variable.builtin": "cell/range references",
      "variable.parameter": "LET/LAMBDA-bound names"
    },
    "locals": {
      "local.definition": "generic binding (nvim-treesitter locals)",
      "local.definition.parameter": "LAMBDA parameter binding",
      "local.definition.var": "LET binding",
      "local.reference": "identifier resolved against enclosing scopes",
      "local.scope": "LET/LAMBDA call scope"
    },
    "folds": {
      "fold": "foldable region"
    },
    "indents": {
      "indent.begin": "opens an indented region",
      "indent.branch": "line that closes back to the opening indent",
      "indent.end": "ends an indented region"
    },
    "injections": {
      "injection.content": "string handed to another parser"
    },
    "textobjects": {
      "function.inner": "call arguments",
      "function.outer": "whole call"
    }
  }
}
